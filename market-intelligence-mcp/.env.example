# =============================================================================
# Market Intelligence MCP Server - Environment Configuration Template
# =============================================================================

# Service Identity & Runtime
MCP_ENV=development
MCP_LOG_LEVEL=INFO
MCP_LOG_FORMAT=console
MCP_HOST=0.0.0.0
MCP_PORT=8080
MCP_SERVER_NAME=market-intelligence-mcp
MCP_SERVER_VERSION=1.0.0

# Transport & Reverse Proxy Security
MCP_STREAMABLE_HTTP_PATH=/mcp
MCP_JSON_RESPONSE=false
MCP_STATELESS_HTTP=false
MCP_ENABLE_DNS_REBINDING_PROTECTION=true
MCP_ALLOWED_HOSTS=["localhost:*","127.0.0.1:*","mcp.example.com"]
MCP_ALLOWED_ORIGINS=["http://localhost:*","http://127.0.0.1:*","https://mcp.example.com"]

# Upstream FastAPI Market Intelligence Backend
MCP_BACKEND_BASE_URL=http://backend:8000
MCP_BACKEND_INTERNAL_API_KEY=change-me-backend-internal-api-key
MCP_BACKEND_CONNECT_TIMEOUT_SECONDS=3.0
MCP_BACKEND_READ_TIMEOUT_SECONDS=15.0
MCP_BACKEND_WRITE_TIMEOUT_SECONDS=5.0
MCP_BACKEND_POOL_TIMEOUT_SECONDS=5.0
MCP_BACKEND_MAX_CONNECTIONS=100
MCP_BACKEND_MAX_KEEPALIVE_CONNECTIONS=20
MCP_BACKEND_KEEPALIVE_EXPIRY_SECONDS=30.0
MCP_BACKEND_MAX_RETRIES=2

# Zero-Trust Authentication - Flow A: Internal Service-to-Service + Delegated JWT
MCP_INTERNAL_API_KEY=change-me-gateway-internal-api-key
MCP_INTERNAL_JWT_ISSUER=https://orchestrator.internal
MCP_INTERNAL_JWT_AUDIENCE=market-intelligence-mcp
MCP_INTERNAL_JWT_ALGORITHM=HS256
MCP_INTERNAL_JWT_SECRET=change-me-internal-jwt-hs256-secret-32-bytes

# Zero-Trust Authentication - Flow B: External OAuth 2.1 Resource Server
MCP_OAUTH_ENABLED=true
MCP_OAUTH_RESOURCE_SERVER_URL=https://mcp.example.com/mcp
MCP_OAUTH_ISSUER=https://auth.example.com
MCP_OAUTH_AUDIENCE=https://mcp.example.com/mcp
MCP_OAUTH_ALGORITHMS=["RS256","HS256"]
MCP_OAUTH_JWKS_URL=https://auth.example.com/.well-known/jwks.json
# Optional static public key PEM or HS256 secret (primarily for offline/local testing)
MCP_OAUTH_PUBLIC_KEY=
MCP_OAUTH_SUPPORTED_SCOPES=["market:read","portfolio:read","portfolio:write","simulation:execute","research:write"]

# Stdio Local Debugging Principal (NEVER used on HTTP transport)
MCP_STDIO_USER_ID=local-stdio-analyst
MCP_STDIO_CLIENT_ID=mcp-inspector-stdio
MCP_STDIO_SCOPES=["market:read","portfolio:read","portfolio:write","simulation:execute","research:write"]

# Resilience: Circuit Breaker, Caching & Rate Limiting
MCP_CIRCUIT_BREAKER_FAILURE_THRESHOLD=5
MCP_CIRCUIT_BREAKER_RECOVERY_TIMEOUT_SECONDS=15.0
MCP_CACHE_MAX_SIZE=4096
MCP_RATE_LIMIT_REQUESTS=120
MCP_RATE_LIMIT_WINDOW_SECONDS=60

# Cache TTLs (seconds)
MCP_TTL_SEARCH_SECONDS=300
MCP_TTL_SCHEDULE_SECONDS=3600
MCP_TTL_QUOTE_SECONDS=5
MCP_TTL_HISTORY_INTRADAY_SECONDS=60
MCP_TTL_HISTORY_DAILY_SECONDS=3600
MCP_TTL_PROFILE_SECONDS=86400
MCP_TTL_METRICS_SECONDS=3600
MCP_TTL_EARNINGS_SECONDS=3600
MCP_TTL_ANALYTICS_SECONDS=60
MCP_TTL_PORTFOLIO_ANALYSIS_SECONDS=15

# Staleness Thresholds (seconds)
MCP_STALE_QUOTE_SECONDS=60
MCP_STALE_HISTORY_INTRADAY_SECONDS=900
MCP_STALE_HISTORY_DAILY_SECONDS=345600
MCP_STALE_FUNDAMENTALS_SECONDS=604800
MCP_STALE_PORTFOLIO_SECONDS=120
MCP_STALE_SCHEDULE_SECONDS=86400
